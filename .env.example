# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional more keys, comma-separated: each is tried in turn when every model is out of quota on the ones before
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used in order when the primary model is rate limited or overloaded
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-2.5-flash-lite,gemini-flash-lite-latest
# Seconds before an AI call is abandoned and reported as an error
AI_TIMEOUT_SECONDS=60
# PDF worker processes (0 = in the API process). More than 1 lets two users' PDF work run at once.
REVIEW_PROCESSES=1
# Web app addresses allowed to call the API, comma-separated (set to the hosted frontend URL when deploying)
CORS_ORIGINS=http://localhost:3000
